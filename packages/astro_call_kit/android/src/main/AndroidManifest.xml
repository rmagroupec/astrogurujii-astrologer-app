<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared here (in the plugin's own manifest) instead of the app's
      AndroidManifest.xml — Gradle's manifest merger folds this into the
      final app manifest automatically, so no manual edits to the app
      module are required. All permissions this service needs
      (FOREGROUND_SERVICE, FOREGROUND_SERVICE_PHONE_CALL, WAKE_LOCK,
      VIBRATE, USE_FULL_SCREEN_INTENT, POST_NOTIFICATIONS) are already
      declared in the app's own manifest.
    -->
    <application>
        <service
            android:name="com.astrologer.vaidikguru.astrocallkit.CallRingtoneService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />
    </application>

</manifest>
